    "query": "SELECT 지결번호 AS approvalNo, 제목 AS title, 합계금액 AS amount, 기안일 AS [date], 시행일 AS execDate, 상태 AS status, 기안자 AS drafter FROM 지출결의테이블 WHERE 기안일 >= DATEADD(day,-60,GETDATE())"
